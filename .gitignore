# Secrets — never commit these
*.pem
*.key
id_rsa*
*.pfx
.env
.env.*
**/vault.yml
**/vault_pass*
credentials.json
*.ovpn

# Cloud CLI / SDK local state
.azure/
.aws/
*.tfstate
*.tfstate.backup
.terraform/

# VM / hypervisor artifacts (large binaries — don't belong in git)
*.vdi
*.vmdk
*.ova
*.ovf
*.iso
.vagrant/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Ansible
*.retry

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Partial browser downloads (ISOs landing in this folder)
*.crdownload
*.part
*.tmp

# Lab credentials — kept locally, never committed
passwords.txt
passwords.*
credentials.txt
creds.txt
secrets.txt
*.secret

# SSH keys (Ed25519 and PuTTY formats)
id_ed25519*
*_ed25519
*_ed25519.pub
*.ppk
